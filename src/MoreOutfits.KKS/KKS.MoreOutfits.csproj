<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>KKS_MoreOutfits</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet packaging properties -->
    <IsPackable>true</IsPackable>
    <PackageId>MoreOutfits.KoikatsuSunshine</PackageId>
    <PackageDescription>Allows user to add more outfit slots to characters</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="IllusionModdingAPI.KKSAPI" Version="1.45.1" />
  </ItemGroup>
  <Import Project="..\Shared\Shared.projitems" Label="Shared" />
  <Import Project="..\MoreOutfits.Core\MoreOutfits.Core.projitems" Label="Shared" />
</Project>